<%# locals: (import:) %>

<%= render DS::Alert.new(variant: :info, message: t(".intro")) %>

<%= styled_form_with model: @import, url: import_configuration_path(@import), scope: :import, method: :patch, class: "space-y-4 mt-4" do |form| %>
  <div class="flex items-center gap-4">
    <%= form.select :date_col_label, import.csv_headers, { include_blank: t(".leave_empty"), label: t(".date") }, required: true, disabled: import.complete? %>
    <%= form.select :date_format, Family::DATE_FORMATS, { label: t(".date_format_label") }, required: true, disabled: import.complete? %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.select :amount_col_label, import.csv_headers, { include_blank: t(".leave_empty"), label: t(".amount") }, required: true, disabled: import.complete? %>
    <%= form.select :signage_convention, [[t(".incomes_negative"), "inflows_negative"], [t(".incomes_positive"), "inflows_positive"]], { label: true }, disabled: import.complete? %>
  </div>

  <%= form.select :number_format, Import::NUMBER_FORMATS.keys, { label: t(".format") }, required: true, disabled: import.complete? %>
  <%= form.select :name_col_label, import.csv_headers, { include_blank: t(".leave_empty"), label: t(".name_optional") }, disabled: import.complete? %>
  <%= form.select :notes_col_label, import.csv_headers, { include_blank: t(".leave_empty"), label: t(".balance_optional") }, disabled: import.complete? %>

  <%= form.submit t(".apply_configuration"), disabled: import.complete? %>
<% end %>
